# Copy to `.env` and fill in. `.env` is gitignored; this template is not.
#
# The ONLY step in this project that needs a key is recording the LLM response
# cache (`make cache`). Everything else -- the tests, `make metrics`, `make ai`,
# `make demo`, CI -- replays the committed cache and runs with no key and no
# network. If you are just trying to run the project, you do not need this file.

OPENAI_API_KEY=sk-...

# Optional. Only used to push from an environment with no git credentials; it is
# read into the push URL and never written into .git/config or anything tracked.
# GITHUB_TOKEN=github_pat_...
